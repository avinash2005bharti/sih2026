/**
 * Streaming partial result during an active utterance (not sent in
 * `simulated`). Partials always stream straight transcription in the sticky
 * language. No `confidence` is emitted.
 */
export interface RealtimeTranscriptPartial {
    event: "transcript.partial";
    /** Zero-based utterance counter for the session */
    utterance_idx: number;
    /** Partial transcript text so far */
    text: string;
    /**
     * Detected language. Present only when `language_code=auto` was
     * selected on the connection.
     */
    language?: string | undefined;
}
