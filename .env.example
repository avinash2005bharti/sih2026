# ==============================================
# Sovereign On-Premise Agentic AI Workbench .env.example
# ==============================================

# Core AI Service
APP_NAME="Sovereign AI Service"
HOST=0.0.0.0
PORT=8000

# Local Ollama Inference & Embeddings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_HOST=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:1.5b
OLLAMA_CODE_MODEL=qwen2.5-coder:1.5b
OLLAMA_VISION_MODEL=moondream
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Memory Architecture
MEMORY_ENABLED=true

# Short-Term Memory (STM)
STM_ENABLED=true
STM_MAX_MESSAGES=20
STM_MAX_TOKENS=8000

# Long-Term Memory (LTM)
LTM_ENABLED=true
LTM_TOP_K=5
LTM_SCORE_THRESHOLD=0.65
LTM_MAX_CONTEXT=4000
MEM0_ENABLED=true

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
# Keep document RAG and durable memory physically separate.
QDRANT_COLLECTION=sovereign_documents
QDRANT_MEMORY_COLLECTION=sovereign_memory
QDRANT_VECTOR_SIZE=768

# Neo4j Knowledge Graph
NEO4J_URI=bolt://localhost:7687
NEO4J_URL=http://localhost:7474
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=sovereignpass
NEO4J_DATABASE=neo4j

# MongoDB Database
MONGO_URI=mongodb://admin:admin@localhost:27017/sovereign_ai?authSource=admin
MONGO_DB_NAME=sovereign_ai

# Logging
LOG_LEVEL=INFO
